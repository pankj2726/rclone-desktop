# Signing material — never commit
*.jks
*.keystore
*.p12
*.pepk
signing.properties
keystore.properties
release-key*

# Local machine config
local.properties
.gradle/
build/
app/build/
*.iml
.idea/
captures/

# Build outputs (snapshots drop these names anyway)
dist/
out/
target/
*.apk
*.aab
*.ap_
*.dex

# Generated deliverables live in artifacts/ on disk but never inside git:
# a bundle committed into the repo contains the previous bundle, so each commit
# would grow the repository recursively. artifacts/ is snapshotted, dist/build/out
# are not, so this is exactly where they belong.
artifacts/*.bundle
artifacts/*.zip
