# Signing material — never commit
*.jks
*.keystore
*.p12
*.pepk
signing.properties
keystore.properties
release-key*

# Local machine config
local.properties
.gradle/
build/
app/build/
*.iml
.idea/
captures/

# Build outputs (snapshots drop these names anyway)
dist/
out/
target/
*.apk
*.aab
*.ap_
*.dex

# Generated deliverables live in artifacts/ on disk but never inside git:
# a bundle committed into the repo contains the previous bundle, so each commit
# would grow the repository recursively. artifacts/ is snapshotted, dist/build/out
# are not, so this is exactly where they belong.
artifacts/*.bundle
artifacts/*.zip

# Working downloads (CI artifact zips, extracted APKs). These are never source and never
# deliverables: the same files live in artifacts/ or on the release page. A batch of them
# was committed by accident on 2026-11-08 and removed the same day; they remain in history
# (about 10 MB of pack), which is a size cost, not a disclosure - each one is a public CI
# artifact. Say the word if you want the history rewritten to reclaim it.
cache/
